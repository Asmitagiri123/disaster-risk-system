# Server
PORT=5000
NODE_ENV=development
# Set to your frontend origin (e.g. http://localhost:5000) in production
CORS_ORIGIN=*

# MongoDB
MONGO_URI=mongodb://localhost:27017/disaster_prediction

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Python ML service (XGBoost flood/landslide models, served by models/predict_service.py)
ML_SERVICE_URL=http://localhost:8000

# External weather polling (Open-Meteo, free)
# How often the scheduler runs a poll pass
EXTERNAL_POLL_INTERVAL=10
# Min minutes between re-evaluations of a calm district (free-tier budget)
EXTERNAL_POLL_WINDOW_MIN=30
# Min minutes between re-evaluations of a district with an active moderate+ alert
EXTERNAL_FAST_TRACK_WINDOW_MIN=10
# Per-district poll parallelism
EXTERNAL_POLL_CONCURRENCY=8

# Sensor API key for secure ingestion (x-sensor-api-key header)
SENSOR_API_KEY=your_sensor_api_key_here

# Sensor polling interval (in minutes) for the scheduled prediction job
SENSOR_POLL_INTERVAL=15

# Optional local fallback models (TensorFlow.js) — only used if the Python
# ML service is unreachable or a disaster type has no XGBoost model.
EARTHQUAKE_MODEL_PATH=./src/ml/models/earthquake_model/model.json
FLOOD_MODEL_PATH=./src/ml/models/flood_model/model.json
LANDSLIDE_MODEL_PATH=./src/ml/models/landslide_model/model.json

# Alert thresholds (0.0 - 1.0) for the local fallback path
EARTHQUAKE_THRESHOLD=0.70
FLOOD_THRESHOLD=0.65
LANDSLIDE_THRESHOLD=0.60

# Optional notifications — skipped entirely when unset
# Twilio SMS
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Nodemailer (Gmail example)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=DisasterAlert <your_email@gmail.com>
