# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/disaster_prediction

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Twilio SMS
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Nodemailer (Gmail example)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=DisasterAlert <your_email@gmail.com>

# ML Model paths
EARTHQUAKE_MODEL_PATH=./src/ml/models/earthquake_model/model.json
FLOOD_MODEL_PATH=./src/ml/models/flood_model/model.json
LANDSLIDE_MODEL_PATH=./src/ml/models/landslide_model/model.json

# Alert thresholds (0.0 - 1.0)
EARTHQUAKE_THRESHOLD=0.70
FLOOD_THRESHOLD=0.65
LANDSLIDE_THRESHOLD=0.60

# Sensor API key for secure ingestion
SENSOR_API_KEY=your_sensor_api_key_here

# Sensor polling interval (in minutes)
SENSOR_POLL_INTERVAL=15
